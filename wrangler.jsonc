{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cc-cafe-reservation",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },

  "vars": {
    "GAS_BACKEND_URL": "https://script.google.com/macros/s/AKfycbyQ_XGiFbgjdvUK1DhzNjdWPGZ2hNI0BWyj6g1Bv0dZqGAohQLZkV0wjUXCT6cvtvMoig/exec"
  },

  "kv_namespaces": [
    { "binding": "CC_CACHE", "id": "487edbdf89f04ccba4d5cca9882a383d" }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
